{
  "ci": {
    "collect": {
      "url": [
        "http://127.0.0.1:4322/",
        "http://127.0.0.1:4322/the-issue/",
        "http://127.0.0.1:4322/how-we-win/",
        "http://127.0.0.1:4322/evidence/",
        "http://127.0.0.1:4322/take-action/",
        "http://127.0.0.1:4322/about/",
        "http://127.0.0.1:4322/investments/",
        "http://127.0.0.1:4322/progress/",
        "http://127.0.0.1:4322/policy/",
        "http://127.0.0.1:4322/privacy/",
        "http://127.0.0.1:4322/take-action/thanks/"
      ],
      "startServerCommand": "npx astro preview --host 127.0.0.1 --port 4322 --ignore-lock",
      "startServerReadyPattern": "127.0.0.1:4322",
      "numberOfRuns": 1,
      "settings": {
        "preset": "desktop",
        "chromeFlags": "--headless=new --no-sandbox"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "error",
          {
            "minScore": 0.97
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 1
          }
        ],
        "categories:best-practices": [
          "error",
          {
            "minScore": 1
          }
        ],
        "categories:seo": [
          "error",
          {
            "minScore": 1
          }
        ],
        "resource-summary:total:size": [
          "error",
          {
            "maxNumericValue": 250000
          }
        ],
        "resource-summary:third-party:count": [
          "error",
          {
            "maxNumericValue": 0
          }
        ]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci/desktop"
    }
  }
}