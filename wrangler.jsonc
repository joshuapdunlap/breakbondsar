{
  // Cloudflare Workers static assets: no Worker script, only the built site in ./dist.
  // public/_headers and public/_redirects are copied into dist and applied by Cloudflare.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "breakbondsar",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
