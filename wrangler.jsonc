{
  // Cloudflare Workers static assets: no Worker script, only the built site in ./dist.
  // public/_headers and public/_redirects are copied into dist and applied by Cloudflare.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "breakbondsar",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  // The apex is a Workers custom domain. www is not attached: a Cloudflare Redirect Rule
  // sends www.breakbondsar.org/* to https://breakbondsar.org/ with the path and query.
  // The workers.dev address stays on as a noindex preview (see public/_headers).
  "routes": [{ "pattern": "breakbondsar.org", "custom_domain": true }],
  "workers_dev": true,
  // The tests run `wrangler dev --env test`. With a route set, wrangler dev rewrites every
  // request to breakbondsar.org, so the noindex rule for other hosts could not be tested.
  "env": { "test": { "routes": [] } }
}
