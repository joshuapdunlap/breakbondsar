---
import "../styles/global.css";
import lalezar from "../fonts/lalezar-latin.woff2?url";
import markazi from "../fonts/markazi-text-latin.woff2?url";
import Masthead from "../components/Masthead.astro";
import Footer from "../components/Footer.astro";
import TellBar from "../components/TellBar.astro";
import { PAGES, SITE } from "../data/site";

interface Props {
  /** The page's URL path, e.g. "/the-issue/". */
  path: string;
  /** Set on pages that are not one of the ten content pages (the 404). */
  title?: string;
  description?: string;
  noindex?: boolean;
}
const { path, title: titleOverride, description: descriptionOverride, noindex = false } = Astro.props;
const meta = PAGES[path];
const title = titleOverride ?? meta?.title ?? SITE.name;
const description = descriptionOverride ?? meta?.description ?? SITE.tagline;
const canonical = new URL(path, SITE.origin).href;
const ogImage = meta?.ogImage ? new URL(meta.ogImage, SITE.origin).href : new URL(SITE.mark, SITE.origin).href;

const graph: Record<string, unknown>[] = [];
if (path === "/") {
  graph.push(
    {
      "@type": "Organization",
      "@id": `${SITE.origin}/#organization`,
      name: SITE.name,
      url: `${SITE.origin}/`,
      description: SITE.tagline,
      email: SITE.email,
      logo: { "@type": "ImageObject", url: new URL(SITE.mark, SITE.origin).href },
      sameAs: [SITE.instagram],
    },
    { "@type": "WebSite", "@id": `${SITE.origin}/#website`, name: SITE.name, url: `${SITE.origin}/`, publisher: { "@id": `${SITE.origin}/#organization` } },
  );
} else if (meta?.breadcrumb) {
  graph.push({
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: `${SITE.origin}/` },
      { "@type": "ListItem", position: 2, name: meta.breadcrumb, item: canonical },
    ],
  });
}
const jsonld = graph.length ? JSON.stringify({ "@context": "https://schema.org", "@graph": graph }) : null;
---

<!doctype html>
<html lang="en-US">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#2b3517" />
    <link rel="preload" href={lalezar} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={markazi} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/icon-192.png" type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={meta?.ogTitle ?? title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    {meta?.ogImageWidth && <meta property="og:image:width" content={meta.ogImageWidth} />}
    {meta?.ogImageHeight && <meta property="og:image:height" content={meta.ogImageHeight} />}
    {meta?.ogImageAlt && <meta property="og:image:alt" content={meta.ogImageAlt} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={meta?.ogTitle ?? title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    {meta?.ogImageAlt && <meta name="twitter:image:alt" content={meta.ogImageAlt} />}
    {jsonld && <script type="application/ld+json" set:html={jsonld} />}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Masthead path={path} />
    <main id="main" tabindex="-1">
      <slot />
      {path !== "/take-action/" && <TellBar />}
    </main>
    <Footer />
    <script>
      import "../scripts/enhance";
    </script>
  </body>
</html>
