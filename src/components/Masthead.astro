---
import Icon from "./Icon.astro";
import { NAV, SITE } from "../data/site";

interface Props {
  path: string;
}
const { path } = Astro.props;
const isCurrent = (item: (typeof NAV)[number]) =>
  item.href === path || ("section" in item && (item.section as readonly string[]).includes(path));
---

<header class="masthead on-olive" id="top">
  <div class="wrap masthead__inner">
    <a class="brand" href="/">
      <img class="brand__mark" src={SITE.mark} alt="" width="44" height="44" />
      <span class="brand__words">
        <span class="brand__name">Break the Bonds</span>{" "}
        <span class="brand__place">Arkansas</span><span class="visually-hidden">, home</span>
      </span>
    </a>
    <nav class="mainnav" aria-label="Main navigation">
      <ul>
        {
          NAV.map((item) => (
            <li>
              <a href={item.href} aria-current={item.href === path ? "page" : isCurrent(item) ? "true" : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <a class="button masthead__act" href="/take-action/" aria-current={path === "/take-action/" ? "page" : undefined}>
      Take action <Icon name="arrow-right" />
    </a>
  </div>
</header>

<style>
  .masthead {
    position: relative;
    z-index: 2;
  }
  .masthead__inner {
    display: flex;
    align-items: center;
    gap: var(--s-3) var(--s-5);
    padding-block: var(--s-4) var(--s-3);
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: var(--s-3);
    text-decoration: none;
    min-height: 2.75rem;
    margin-right: auto;
  }
  .brand__mark {
    width: 2.75rem;
    height: 2.75rem;
    flex: none;
  }
  .brand__words {
    display: flex;
    flex-direction: column;
    line-height: 0.95;
  }
  .brand__name {
    font-family: var(--display);
    font-size: 1.5rem;
  }
  .brand__place {
    font-family: var(--display);
    font-size: 1.05rem;
    color: var(--olive-screen);
    letter-spacing: 0.02em;
  }
  .mainnav ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 var(--s-4);
  }
  .mainnav a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    font-weight: 600;
    font-size: 1.25rem;
    text-decoration: none;
    border-bottom: 3px solid transparent;
  }
  .mainnav a:hover {
    border-bottom-color: var(--olive-screen);
  }
  .mainnav a[aria-current] {
    border-bottom-color: var(--paper);
  }
  .masthead__act {
    min-height: 2.75rem;
    font-size: 1.2rem;
    flex: none;
  }
  .masthead__act[aria-current="page"] {
    background: var(--paper);
    border-color: var(--paper);
    color: var(--ink);
  }
  @media (max-width: 63.99rem) {
    .masthead__inner {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      grid-template-areas:
        "brand act"
        "nav nav";
      padding-block: var(--s-3) var(--s-1);
      gap: var(--s-2) var(--s-3);
    }
    .brand {
      grid-area: brand;
    }
    .masthead__act {
      grid-area: act;
      font-size: 1.05rem;
      padding-inline: 0.75em;
      gap: 0.4em;
    }
    .brand {
      gap: var(--s-2);
    }
    .brand__mark {
      width: 2.5rem;
      height: 2.5rem;
    }
    .brand__name {
      font-size: 1.3rem;
      white-space: nowrap;
    }
    .mainnav {
      grid-area: nav;
      border-top: 1px solid var(--paper-25);
    }
    .mainnav ul {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0 var(--s-4);
    }
    .mainnav a {
      font-size: 1.15rem;
    }
  }
  /* Narrowest phones: the name may wrap rather than run under the button. */
  @media (max-width: 23rem) {
    .brand__name {
      white-space: normal;
    }
  }
  @media (min-width: 48rem) and (max-width: 63.99rem) {
    .mainnav ul {
      display: flex;
      gap: 0 var(--s-5);
    }
  }
</style>
