---
// The poster sheet that opens every page after the home page: olive ink, the title
// knocked out in paper, crop marks at the corners. Wayfinding rides on the sheet.
interface Props {
  /** The current page's name in the breadcrumb. */
  crumb: string;
  /** A section the page belongs to, shown between Home and the page. */
  parent?: { href: string; label: string };
  class?: string;
}
const { crumb, parent, class: className } = Astro.props;
const hasFoot = Astro.slots.has("foot");
---

<section class:list={["band on-olive crop", { "band--foot": hasFoot }, className]} aria-labelledby="page-title">
  <div class="wrap band__inner">
    <nav class="crumbs" aria-label="Breadcrumb">
      <ol>
        <li><a href="/">Home</a></li>
        {parent && <li><a href={parent.href}>{parent.label}</a></li>}
        <li><span aria-current="page">{crumb}</span></li>
      </ol>
    </nav>
    <h1 id="page-title"><slot name="title" /></h1>
    <div class="band__intro"><slot name="intro" /></div>
    <slot />
  </div>
  <slot name="foot" />
</section>

<style>
  .band {
    padding-block: var(--s-6) var(--s-8);
  }
  .band--foot {
    padding-bottom: 0;
  }
  .band--foot > :global(:last-child) {
    margin-top: var(--s-7);
  }
  .band__inner > * + * {
    margin-top: var(--s-5);
  }
  .crumbs ol {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    font-size: var(--step--1);
    color: var(--olive-screen);
  }
  .crumbs li + li::before {
    content: "/";
    padding-inline: 0.5em;
    opacity: 0.8;
  }
  .crumbs a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    text-decoration-color: var(--olive-screen);
  }
  .crumbs [aria-current] {
    color: var(--paper);
    font-weight: 600;
  }
  .band h1 {
    font-size: var(--step-4);
    max-width: 14ch;
    line-height: 0.95;
    margin-top: var(--s-4);
  }
  .band__intro {
    max-width: 30em;
    font-size: var(--step-1);
    line-height: 1.3;
  }
  .band__intro :global(p + p) {
    margin-top: 0.6em;
  }
</style>
