---
import Base from "../layouts/Base.astro";
import PosterBand from "../components/PosterBand.astro";
import ResearchNav from "../components/ResearchNav.astro";
import RecordFigure from "../components/RecordFigure.astro";
import CloseStrip from "../components/CloseStrip.astro";
import Icon from "../components/Icon.astro";
import index from "../data/evidence-index.json";
