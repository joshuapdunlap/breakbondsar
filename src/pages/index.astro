---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import Timeline from "../components/Timeline.astro";
---

<Base path="/">
  <section class="poster on-olive" aria-labelledby="hero-title">
    <div class="wrap poster__sheet">
      <h1 id="hero-title" class="poster__title">
        <span>Arkansas</span>
        <span class="poster__red">out of</span>
        <span>Israel Bonds.</span>
      </h1>
      <div class="poster__foot">
        <p class="poster__witness">
          <em>Every life.<br /> Every future.</em>
          <span>End our state’s financial support for Israel’s genocide and apartheid.</span>
        </p>
        <p class="poster__lede">
          Palestinians deserve to live, learn, heal, and build their futures in freedom. Break the Bonds | Arkansas organizes
          to end Arkansas’s investment in the Israeli government through Israel Bonds.
        </p>
        <div class="poster__actions">
          <a class="button" href="/take-action/">Act for divestment <Icon name="arrow-right" /></a>
          <a class="go" href="/the-issue/">Why we must act <Icon name="arrow-right" /></a>
        </div>
      </div>
      <p class="poster__tag">For Palestinian freedom</p>
    </div>

    <section class="due on-red" aria-label="Treasury maturity dates">
      <div class="wrap due__inner">
        <div class="due__head">
          <h2 class="due__title" id="due-title">Two maturities this fall.</h2>
          <p class="due__label">State Treasury maturity dates</p>
        </div>
        <ol class="due__stops">
          <li>
            <time datetime="2026-10-01">October 1, 2026</time>
            <span class="due__amount">$10 million</span>
            <span class="due__note">Two $5 million positions</span>
          </li>
          <li>
            <time datetime="2026-11-01">November 1, 2026</time>
            <span class="due__amount">$10 million</span>
            <span class="due__note">One position</span>
          </li>
        </ol>
        <div class="due__act">
          <a class="button button--ink" href="/take-action/#officials">Tell the Treasurer <Icon name="arrow-right" /></a>
          <p class="due__source">
            Scheduled in the Treasury’s June 30, 2025 statement. Ask Treasurer Thurston to bring that money home and keep it
            out of Israel Bonds.
          </p>
        </div>
      </div>
    </section>
  </section>

  <section class="witness" aria-labelledby="home-witness-title">
    <div class="wrap witness__grid">
      <div class="witness__context">
        <h2 id="home-witness-title">A life devoted<br /><em>to saving lives.</em></h2>
        <p class="dateline">Marwa · Gaza</p>
        <p>
          Marwa wanted to become a surgeon. Her March 2024 diary describes how repeated displacement interrupted her medical
          studies, and the future she still hoped to build.
        </p>
        <a class="go" href="/the-issue/#witness">Continue her story <Icon name="arrow-right" /></a>
      </div>
      <figure class="witness__quote">
        <blockquote>
          <p>“I entered medical school because I wanted to save people’s lives.”</p>
        </blockquote>
        <figcaption>
          <strong>Marwa</strong>
          <span>Palestinian medical student in Gaza</span>
          <a class="go" href="https://www.unicef.org/stories/day-gaza-marwas-diary"
            >Her diary, published by UNICEF · March 20, 2024 <Icon name="external" /></a
          >
        </figcaption>
      </figure>
    </div>
  </section>

  <section class="responsibility screen" aria-labelledby="home-responsibility-title">
    <div class="wrap split">
      <h2 id="home-responsibility-title">Israel’s government<br />and military.<br /><em>Our responsibility<br />to act.</em></h2>
      <div class="split__body">
        <p>
          The Palestinian human rights organization Al-Haq documents Israel’s systematic destruction of Gaza’s healthcare
          system as part of its campaign of genocide.
        </p>
        <p>
          Israel Bonds lend money directly to that state. Arkansas’s investment decisions give us a place to withdraw support
          and organize for change.
        </p>
        <div class="stack">
          <a class="go" href="/the-issue/#responsibility">Read the human rights evidence <Icon name="arrow-right" /></a>
          <a class="go" href="/the-issue/#arkansas">See Arkansas’s documented investments <Icon name="arrow-right" /></a>
        </div>
      </div>
    </div>
  </section>

  <section class="records" aria-labelledby="home-records-title">
    <div class="wrap">
      <div class="split records__head">
        <h2 id="home-records-title">Arkansas<br /><em>made these choices.</em></h2>
        <p>
          Public records document holdings, purchases, and funding of an investment mandate. Each finding below is tied to its
          date and its source.
        </p>
      </div>
      <ul class="records__list">
        <li>
          <a class="record-row" href="/the-issue/#treasury">
            <h3>State Treasury</h3>
            <p><strong>$55 million held</strong><br />Bondholder statement · June 30, 2025</p>
            <Icon name="arrow-right" class="record-row__go" />
          </a>
        </li>
        <li>
          <a class="record-row" href="/the-issue/#public-employees">
            <h3>Public employees’ retirement</h3>
            <p><strong>$25 million held</strong><br />APERS · preliminary report, September 7, 2026</p>
            <Icon name="arrow-right" class="record-row__go" />
          </a>
        </li>
        <li>
          <a class="record-row" href="/the-issue/#teachers">
            <h3>Teachers’ retirement</h3>
            <p><strong>$50 million funded; $9.9 million bought</strong><br />ATRS · January–February 2026</p>
            <Icon name="arrow-right" class="record-row__go" />
          </a>
        </li>
      </ul>
      <p class="records__scope">
        These are separate, dated findings. They are not a combined current-holdings total. <a href="/evidence/"
          >Read the supporting documents and follow the investment record.</a
        >
      </p>
      <Timeline id="mt-home" />
    </div>
  </section>

  <section class="demand" aria-labelledby="home-demand-title">
    <div class="wrap demand__grid">
      <div class="demand__context">
        <h2 id="home-demand-title">The change we demand</h2>
        <p>Stop adding money. Bring the principal home as existing bonds mature. End the financial relationship.</p>
        <a class="go" href="/how-we-win/">How we turn that demand into a win <Icon name="arrow-right" /></a>
      </div>
      <ul class="demand__lines">
        <li>No new Israel Bonds.</li>
        <li>No renewals.</li>
        <li>No reinvestment.</li>
      </ul>
    </div>
  </section>

  <section class="action on-red" aria-labelledby="home-action-title">
    <div class="wrap split">
      <h2 id="home-action-title">No more money<br /><em>for Israel Bonds.</em></h2>
      <div class="split__body">
        <p>
          Ask Arkansas Treasurer John Thurston to publicly commit to no new purchases, no renewals, and no reinvestment. Bring
          someone with you into that demand.
        </p>
        <a class="button button--ink" href="/take-action/#officials">Take the demand to Thurston <Icon name="arrow-right" /></a>
      </div>
    </div>
  </section>
</Base>

<style>
  /* The poster sheet: one message, the title knocked out at full measure */
  .poster__sheet {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--s-5);
    padding-block: var(--s-5) var(--s-5);
  }
  .poster__title {
    /* Phones: three lines; the longest, "Israel Bonds.", fills the measure. */
    font-size: clamp(3.5rem, calc((100vw - 2.25rem) / 5.6), 7.5rem);
    line-height: 0.84;
    letter-spacing: -0.01em;
    max-width: none;
  }
  .poster__title span {
    display: block;
  }
  .poster__red {
    color: var(--red);
    animation: register 900ms var(--ease-out) 120ms backwards;
  }
  /* The one authored moment: the red pass drops into register with the olive sheet. */
  @keyframes register {
    from {
      transform: translate(0.06em, -0.035em);
    }
    to {
      transform: none;
    }
  }
  .poster__foot {
    display: grid;
    gap: var(--s-4);
    padding-top: var(--s-4);
    border-top: 2px solid var(--olive-screen);
  }
  .poster__witness {
    display: grid;
    gap: var(--s-2);
    font-size: var(--step-1);
    line-height: 1.25;
    max-width: 22em;
  }
  .poster__witness em {
    font-family: var(--display);
    font-weight: 400;
    font-size: var(--step-2);
    line-height: 0.95;
  }
  .poster__lede {
    max-width: 32em;
  }
  .poster__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-3) var(--s-5);
  }
  /* The poster's sign-off line, printed in the screened ink at the foot of the sheet. */
  .poster__tag {
    font-family: var(--display);
    font-size: var(--step-1);
    color: var(--olive-screen);
    line-height: 1;
  }
  @media (min-width: 60rem) {
    .poster__title {
      /* Two lines; "Arkansas out of" fills the measure. */
      font-size: clamp(5rem, calc((100vw - 5.75rem) / 6.75), 11rem);
    }
    .poster__title span:nth-child(-n + 2) {
      display: inline;
    }
    .poster__title span:nth-child(2)::before {
      content: " ";
    }
    .poster__foot {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.25fr) auto;
      align-items: start;
      gap: var(--s-6);
    }
    .poster__actions {
      flex-direction: column;
      align-items: flex-start;
    }
  }

  /* The red strip at the sheet's foot: what is due now */
  .due {
    padding-block: var(--s-5);
  }

  .due__inner {
    display: grid;
    gap: var(--s-4) var(--s-6);
    grid-template-columns: minmax(0, 1fr);
  }
  .due__label {
    font-weight: 700;
    font-size: var(--step--1);
    margin-top: var(--s-2);
  }
  .due__title {
    font-family: var(--display);
    font-size: var(--step-2);
    line-height: 1;
  }
  .due__stops {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--s-4);
  }
  .due__stops li {
    display: flex;
    flex-direction: column;
    border-top: 3px solid var(--ink);
    padding-top: var(--s-2);
    line-height: 1.2;
  }
  .due__stops time {
    font-weight: 700;
  }
  .due__amount {
    font-family: var(--display);
    font-size: clamp(1.75rem, 1rem + 1.6vw, 2.75rem);
    line-height: 1.05;
  }
  .due__note {
    font-size: var(--step--1);
  }
  .due__act {
    display: grid;
    gap: var(--s-3);
    align-content: start;
  }
  .due__source {
    font-size: var(--step--1);
    max-width: 30em;
  }
  @media (min-width: 60rem) {
    .due__inner {
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.2fr) minmax(0, 1fr);
      align-items: start;
    }
  }

  /* Witness */
  .witness {
    padding-block: var(--s-8);
  }
  .witness__grid {
    display: grid;
    gap: var(--s-6) var(--s-8);
    grid-template-columns: minmax(0, 1fr);
  }
  .witness__context > * + * {
    margin-top: var(--s-4);
  }
  .witness__context .dateline {
    margin-top: var(--s-3);
  }
  .witness__context p:not(.dateline) {
    max-width: 30em;
  }
  .witness__quote {
    margin: 0;
    border-top: 0.75rem solid var(--olive);
    padding-top: var(--s-5);
  }
  .witness__quote blockquote {
    margin: 0;
    font-size: clamp(2rem, 1.2rem + 3.4vw, 3.75rem);
    line-height: 1.08;
    font-weight: 500;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }
  .witness__quote figcaption {
    display: grid;
    gap: var(--s-1);
    margin-top: var(--s-5);
    font-size: var(--step--1);
  }
  .witness__quote figcaption strong {
    font-family: var(--display);
    font-weight: 400;
    font-size: 1.5rem;
  }
  @media (min-width: 60rem) {
    .witness__grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.6fr);
    }
    .witness__quote {
      grid-column: 2;
      grid-row: 1;
    }
    .witness__context {
      grid-column: 1;
      grid-row: 1;
      align-self: end;
    }
  }

  /* Two columns: a heading set as a poster line, the body beside it */
  .split {
    display: grid;
    gap: var(--s-5) var(--s-8);
    grid-template-columns: minmax(0, 1fr);
  }
  .split > h2 {
    font-size: var(--step-3);
  }
  .split__body {
    max-width: 30em;
  }
  .split__body > * + * {
    margin-top: var(--s-4);
  }
  @media (min-width: 60rem) {
    .split {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      align-items: start;
    }
  }
  .responsibility {
    padding-block: var(--s-8);
    border-block: 2px solid var(--rule);
  }

  /* The record */
  .records {
    padding-block: var(--s-8);
  }
  .records__head p {
    max-width: 30em;
    align-self: end;
  }
  .records__list {
    list-style: none;
    margin: var(--s-7) 0 0;
    padding: 0;
    border-top: 3px solid var(--rule);
  }
  .record-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: var(--s-2) var(--s-5);
    align-items: start;
    padding-block: var(--s-5);
    border-bottom: 1px solid var(--rule-soft);
    text-decoration: none;
  }
  .record-row h3 {
    font-family: var(--text);
    font-weight: 700;
    font-size: var(--step-0);
    line-height: 1.2;
  }
  .record-row p {
    grid-column: 1;
    font-size: var(--step--1);
    color: var(--olive-ink);
  }
  .record-row strong {
    display: inline-block;
    font-family: var(--display);
    font-weight: 400;
    font-size: clamp(1.9rem, 1.2rem + 2.4vw, 3.25rem);
    line-height: 1;
    color: var(--ink);
    margin-bottom: var(--s-2);
  }
  .record-row :global(.record-row__go) {
    grid-column: 2;
    grid-row: 1 / span 2;
    align-self: center;
    width: 2rem;
    height: 2rem;
    transition: transform 200ms var(--ease-out);
  }
  .record-row:hover {
    color: inherit;
  }
  .record-row:hover strong {
    text-decoration: underline;
    text-decoration-thickness: 0.06em;
    text-underline-offset: 0.12em;
  }
  .record-row:hover :global(.record-row__go) {
    transform: translateX(0.3rem);
  }
  @media (min-width: 60rem) {
    .record-row {
      grid-template-columns: minmax(0, 18rem) minmax(0, 1fr) auto;
      align-items: baseline;
    }
    .record-row p {
      grid-column: 2;
      grid-row: 1;
    }
    .record-row :global(.record-row__go) {
      grid-column: 3;
      grid-row: 1;
    }
  }
  .records__scope {
    margin-top: var(--s-5);
    max-width: 40em;
    font-weight: 600;
  }

  /* The demand, printed at poster scale */
  .demand {
    padding-block: var(--s-8);
    border-top: 0.75rem solid var(--olive);
  }
  .demand__grid {
    display: grid;
    gap: var(--s-6) var(--s-8);
    grid-template-columns: minmax(0, 1fr);
  }
  .demand__context h2 {
    font-size: var(--step-2);
  }
  .demand__context > * + * {
    margin-top: var(--s-4);
  }
  .demand__context p {
    max-width: 26em;
  }
  .demand__lines {
    list-style: none;
    margin: 0;
    padding: 0;
    font-family: var(--display);
    font-size: clamp(2.5rem, 1.1rem + 5.2vw, 4.75rem);
    line-height: 0.92;
  }
  .demand__lines li + li {
    margin-top: 0.12em;
  }
  .demand__lines li:first-child {
    color: var(--red-deep);
  }
  @media (min-width: 60rem) {
    .demand__grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
      align-items: end;
    }
  }
  .action {
    padding-block: var(--s-8);
  }
  .action .split__body {
    align-self: end;
  }
  /* Contrast themes paint a backplate behind each line of text. Lalezar's tall line box
     would let one line's backplate cover the line above, so open the leading. */
  @media (forced-colors: active) {
    .poster__red {
      animation: none;
    }
    .due__amount,
    .poster__witness em {
      line-height: 1.6;
    }
  }
</style>
