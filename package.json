{
  "name": "breakbondsar",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "description": "Break the Bonds | Arkansas: Arkansas out of Israel Bonds.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview --host 127.0.0.1 --port 4322",
    "astro": "astro",
    "test": "playwright test",
    "test:pages": "playwright test --project=mobile --project=desktop",
    "test:site": "playwright test --project=site --project=nojs",
    "test:worker": "playwright test --project=worker",
    "lhci": "npm run build && node scripts/lhci.mjs",
    "deploy": "npm run build && wrangler deploy --env=\"\"",
    "deploy:dry": "npm run build && wrangler deploy --env=\"\" --dry-run",
    "check:live": "node scripts/check-live.mjs"
  },
  "dependencies": {
    "astro": "~7.3.8"
  },
  "devDependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@axe-core/playwright": "^4.14.0",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.64.1",
    "typescript": "^5.9.3",
    "wrangler": "^4.151.1"
  }
}
